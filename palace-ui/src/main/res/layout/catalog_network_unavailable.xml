<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/PalaceScreenBackgroundColor"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="32dp"
        android:layout_marginRight="32dp"
        android:background="@color/PalaceScreenBackgroundColor"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/catalogNetIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="128dp"
            android:layout_marginBottom="32dp"
            android:importantForAccessibility="no"
            app:srcCompat="@drawable/network_unavailable" />

        <TextView
            android:id="@+id/catalogNetText0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/catalogNetworkUnavailable0"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/catalogNetText1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/catalogNetworkUnavailable1"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/catalogNetText2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:text="@string/catalogNetworkUnavailable2"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/catalogNetMyBooks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="64dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/tabBooks" />

    </LinearLayout>
</ScrollView>

